{
  "extends": "../tsconfig.json",
  // The dev app is a *host*: `payload-types.ts` augments Payload's generated
  // types, so `CollectionSlug` here is the dev app's own union. The plugin's
  // unit tests and the documentation samples are authored against the generic
  // public types and are gated by the root project instead; compiling them
  // here would only demand fake dev-app slugs. Plugin source is still checked
  // in full, transitively, through `payload.config.ts`.
  "exclude": [
    "docs-samples",
    "../src/**/__tests__/**"
  ],
  "include": [
    "**/*.js",
    "**/*.jsx",
    "**/*.mjs",
    "**/*.cjs",
    "**/*.ts",
    "**/*.tsx",
    "../src/**/*.ts",
    "../src/**/*.tsx",
    "next.config.mjs",
    ".next/types/**/*.ts"
  ],
  "compilerOptions": {
    "baseUrl": "./",
    "paths": {
      "@payload-config": [
        "./payload.config.ts"
      ],
      "payload-plugin-gmc-ecommerce": [
        "../src/index.ts"
      ],
      "payload-plugin-gmc-ecommerce/v2": [
        "../src/exports/v2.ts"
      ]
    },
    "noEmit": true,
    "emitDeclarationOnly": false,
  }
}
