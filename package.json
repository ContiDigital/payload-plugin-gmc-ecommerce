{
  "name": "payload-plugin-gmc-ecommerce",
  "version": "2.0.0-rc.35",
  "description": "Durable one-way Google Merchant Center publication and canonical feeds for Payload CMS",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ContiDigital/payload-plugin-gmc-ecommerce.git"
  },
  "homepage": "https://github.com/ContiDigital/payload-plugin-gmc-ecommerce#readme",
  "bugs": {
    "url": "https://github.com/ContiDigital/payload-plugin-gmc-ecommerce/issues"
  },
  "type": "module",
  "packageManager": "pnpm@10.16.1",
  "keywords": [
    "payload",
    "payloadcms",
    "plugin",
    "google-merchant-center",
    "ecommerce",
    "shopping",
    "product-feed",
    "google-shopping"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./v2": {
      "import": "./dist/exports/v2.js",
      "types": "./dist/exports/v2.d.ts",
      "default": "./dist/exports/v2.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/index.*",
    "dist/exports/v2.*",
    "dist/server/services/sub-services/googleApiClient.*",
    "dist/server/services/sub-services/rateLimiterService.*",
    "dist/server/services/sub-services/retryService.*",
    "dist/server/utilities/access.*",
    "dist/server/utilities/http.*",
    "dist/server/utilities/httpError.*",
    "dist/types/*.d.ts",
    "dist/v2",
    "docs/v2-*.md",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "pnpm clean && pnpm copyfiles && pnpm build:types && pnpm build:swc",
    "build:swc": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths --ignore \"**/*.test.ts\" --ignore \"**/__tests__/**\"",
    "build:types": "tsc -p tsconfig.build.json",
    "clean": "rimraf {dist,*.tsbuildinfo}",
    "copyfiles": "copyfiles -u 1 \"src/**/*.{html,css,scss,ttf,woff,woff2,eot,svg,jpg,png,json}\" dist/",
    "dev": "next dev dev --turbo",
    "dev:generate-importmap": "pnpm dev:payload generate:importmap",
    "dev:generate-types": "pnpm dev:payload generate:types",
    "dev:payload": "cross-env PAYLOAD_CONFIG_PATH=./dev/payload.config.ts payload",
    "generate:importmap": "pnpm dev:generate-importmap",
    "generate:types": "pnpm dev:generate-types",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "pack:smoke": "bash ./scripts/pack-smoke.sh",
    "prepare": "pnpm build",
    "prepack": "pnpm build",
    "release:check": "pnpm lint && pnpm exec tsc --noEmit && pnpm test:coverage && pnpm build && pnpm pack:smoke",
    "test": "pnpm test:int",
    "test:coverage": "vitest --run --coverage",
    "test:v2:db-matrix": "bash ./scripts/test-v2-db-matrix.sh",
    "test:e2e": "playwright test",
    "test:int": "vitest --run",
    "test:live": "pnpm build && vitest --run --config vitest.live.config.js"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@payloadcms/db-mongodb": "3.88.0",
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/db-sqlite": "3.88.0",
    "@payloadcms/eslint-config": "3.28.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@playwright/test": "1.62.1",
    "@swc-node/register": "1.12.1",
    "@swc/cli": "0.8.1",
    "@swc/core": "^1.16.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.9",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/coverage-v8": "4.1.11",
    "copyfiles": "2.4.1",
    "cross-env": "^7.0.3",
    "esbuild": "0.28.2",
    "eslint": "^9.23.0",
    "eslint-config-next": "16.3.3",
    "graphql": "^16.8.1",
    "jsdom": "30.0.1",
    "mongodb-memory-server": "11.2.0",
    "next": "16.3.3",
    "open": "^11.0.2",
    "payload": "3.88.0",
    "prettier": "^3.9.6",
    "qs-esm": "8.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rimraf": "6.1.3",
    "sharp": "0.35.4",
    "sort-package-json": "^4.0.0",
    "typescript": "5.6.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "payload": ">=3.37.0 <4.0.0"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0",
    "pnpm": "^9 || ^10"
  },
  "publishConfig": {
    "access": "public"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ],
    "overrides": {
      "@esbuild-kit/core-utils>esbuild": "0.25.12",
      "@eslint/plugin-kit@<0.3.4": "0.3.4",
      "brace-expansion@<2.0.0": "1.1.18",
      "brace-expansion@>=2.0.0 <3.0.0": "2.1.4",
      "brace-expansion@>=3.0.0 <5.0.9": "5.0.9",
      "dompurify@<=3.4.12": "3.4.13",
      "fast-uri@>=3.0.0 <3.1.6": "3.1.6",
      "flatted@<3.4.4": "3.4.4",
      "immutable@<4.3.9": "4.3.9",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "lodash@>=4.0.0 <4.18.1": "4.18.1",
      "nanoid@<3.3.18": "3.3.18",
      "picomatch@<3.0.0": "2.3.2",
      "picomatch@>=4.0.0 <4.0.7": "4.0.7",
      "piscina@<4.9.4": "4.9.4",
      "postcss@>=8.0.0 <8.5.26": "8.5.26",
      "ws@>=8.0.0 <8.21.3": "8.21.3",
      "yaml@>=1.0.0 <1.10.3": "1.10.3"
    }
  }
}
